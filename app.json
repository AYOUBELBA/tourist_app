{
  "expo": {
    "name": "Ri7la",
    "slug": "ri7la",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F59E0B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ri7la.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F59E0B"
      },
      "package": "com.ri7la.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "statusBar": {
        "hidden": false,
        "translucent": true,
        "backgroundColor": "#00000000"
      },
      "navigationBar": {
        "visible": false,
        "backgroundColor": "#00000000"
      },
      "windowSoftInputMode": "adjustResize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-location",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "behavior": "inset-swipe",
          "visible": "hidden"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a7a57a50-1f85-436f-b456-5495a4cbdf71"
      }
    }
  }
}